# Project URL from Supabase Settings → API. Use the origin only, without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only. Settings → API → service_role. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI generation. Without this, curated Thai meals are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
